<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>


<table id="movies">
  <thead>
    <tr>
      <th class="<%= sort_table("title") %>">
        <%= sort_symbol("title") %> Title
        <%= link_to "asc", movies_path(sort: "title", direction: "asc") %>
        <%= link_to "desc", movies_path(sort: "title", direction: "desc") %>
      </th>
      <th class="<%= sort_table("rating") %>">
        <%= sort_symbol("rating") %> Rating
        <%= link_to "asc", movies_path(sort: "rating", direction: "asc") %>
        <%= link_to "desc", movies_path(sort: "rating", direction: "desc") %>
      </th>
      <th>
        Description
      </th>
      <th class="<%= sort_table("release_date") %>">
        <%= sort_symbol("release_date") %> Release Date 
        <%= link_to "asc", movies_path(sort: "release_date", direction: "asc") %>
        <%= link_to "desc", movies_path(sort: "release_date", direction: "desc") %>
      </th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td class="<%= sort_table("title") %>"><%= movie.title %></td>
        <td class="<%= sort_table("rating") %>"><%= movie.rating %></td>
        <td><%= movie.description %></td>
        <td class="<%= sort_table("release_date") %>"><%= movie.release_date&.strftime("%Y-%m-%d") %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4" align="center">
        <%= link_to "New movie", new_movie_path %>
      </td>
    </tr>
  </tfoot>
</table>